# ─── Database ─────────────────────────────────────────────────────────────────
# Docker service name "postgres" resolves inside compose network
DATABASE_URL=postgresql+asyncpg://itrade:itrade@postgres:5432/itrade

# ─── Cache ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
# Token expiry in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Market Data APIs ─────────────────────────────────────────────────────────
# Alpha Vantage — free tier at https://www.alphavantage.co/support/#api-key
# Use "demo" to test with sample endpoints
ALPHA_VANTAGE_API_KEY=demo

# Finnhub — free tier at https://finnhub.io/register
FINNHUB_API_KEY=your_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=iTrade
APP_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:80
