FROM node:20-alpine

WORKDIR /app

# Install dependencies (node_modules will be a named volume for performance)
COPY package*.json ./
RUN npm ci

# Copy source (overridden by bind mount in docker-compose dev)
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
